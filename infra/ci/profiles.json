{
  "linux-x64-avx": {
    "runner": "ubuntu-24.04",
    "setup_profile": "default",
    "args_file": "args.gn",
    "target_os": "linux",
    "target_cpu": "x64",
    "out_dir": "out/thorium",
    "host_deps_args": [
      "--no-prompt",
      "--no-syms",
      "--no-arm",
      "--no-chromeos-fonts",
      "--no-backwards-compatible"
    ],
    "jobs": 2,
    "compile_minutes": 210,
    "max_stages": 10,
    "checkpoint_retention_days": 2,
    "product_retention_days": 14,
    "targets": [
      "thorium_all",
      "chrome/installer/linux:stable_deb",
      "chrome/installer/linux:stable_rpm"
    ],
    "products": [
      "thorium-browser_{version}_AVX.deb",
      "thorium-browser_{version}_AVX.rpm",
      "thorium-browser_{version}_AVX.zip",
      "Thorium_Browser_{version}_AVX.AppImage"
    ],
    "host_cpu": "x64",
    "deb_arch": "amd64",
    "rpm_arch": "x86_64",
    "portable_profile": "AVX",
    "appimage_arch": "x86_64",
    "appimage_runtime": "runtime-x86_64",
    "expected_gn_args": {
      "thorium_x86_profile": "avx",
      "chrome_pgo_phase": 2,
      "use_thin_lto": true,
      "is_cfi": true
    }
  },
