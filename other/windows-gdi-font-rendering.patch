diff --git a/content/renderer/gdi_font_manager_win.cc b/content/renderer/gdi_font_manager_win.cc
new file mode 100644
index 0000000000000..400cd29f0206b
--- /dev/null
+++ b/content/renderer/gdi_font_manager_win.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/renderer/gdi_font_manager_win.h"
+
+#include <windows.h>
+
+#include <string>
+#include <tuple>
+
+#include "base/containers/flat_set.h"
+#include "base/no_destructor.h"
+#include "content/child/font_data/font_data_manager.h"
+#include "content/public/child/child_thread.h"
+#include "skia/ext/font_utils.h"
+#include "third_party/skia/include/core/SkFontMgr.h"
+#include "third_party/skia/include/ports/SkTypeface_win.h"
+#include "ui/gfx/win/gdi_font_manager.h"
+
+namespace content {
+
+namespace {
+
+int CALLBACK OnFontFamily(const LOGFONT*,
+                          const TEXTMETRIC*,
+                          DWORD,
+                          LPARAM found) {
+  *reinterpret_cast<bool*>(found) = true;
+  return 0;
+}
+
+// Fonts added with AddFontMemResourceEx (web fonts) are private to this
+// process and don't enumerate; the browser can't load those for us.
+bool IsSystemFont(const LOGFONT& log_font) {
+  // EnumFontFamiliesEx reads only the face name, charset and pitch fields.
+  LOGFONT query = log_font;
+  query.lfCharSet = DEFAULT_CHARSET;
+  query.lfPitchAndFamily = 0;
+  bool found = false;
+  HDC dc = ::CreateCompatibleDC(nullptr);
+  ::EnumFontFamiliesExW(dc, &query, OnFontFamily,
+                        reinterpret_cast<LPARAM>(&found), 0);
+  ::DeleteDC(dc);
+  return found;
+}
+
+// Skia calls this when a GDI call on a font fails, which under the lowered
+// token can mean GDI could not read the font file; the browser then loads the
+// font on our behalf. Skia also calls it for harmless failures such as a
+// missing table, so ask once per face and style: the request is a sync IPC
+// and the browser keeps what it loads. Only the main thread has a
+// ChildThread; other threads skip this and Skia retries without it.
+void EnsureLogFontAccessible(const LOGFONT& log_font) {
+  ChildThread* child_thread = ChildThread::Get();
+  if (!child_thread) {
+    return;
+  }
+  static base::NoDestructor<
+      base::flat_set<std::tuple<std::wstring, LONG, BYTE>>>
+      requested;
+  if (!requested
+           ->emplace(log_font.lfFaceName, log_font.lfWeight, log_font.lfItalic)
+           .second ||
+      !IsSystemFont(log_font)) {
+    return;
+  }
+  child_thread->PreCacheFont(log_font);
+}
+
+}  // namespace
+
+void InstallGdiFontManager() {
+  SkTypeface_SetEnsureLOGFONTAccessibleProc(EnsureLogFontAccessible);
+  // The DirectWrite-based FontDataManager handles fallback and color fonts,
+  // and picks the installed fonts pages ask for, as in other browsers (the
+  // system's GDI font settings are for its own UI, not for web pages).
+  skia::OverrideDefaultSkFontMgr(gfx::win::CreateGdiFontManager(
+      sk_make_sp<font_data_service::FontDataManager>(),
+      /*fonts_like_directwrite=*/true));
+}
+
+}  // namespace content
