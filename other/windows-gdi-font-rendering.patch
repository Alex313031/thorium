+
+using Coordinate = SkFontArguments::VariationPosition::Coordinate;
+
+constexpr SkFontTableTag kColorTables[] = {
+    SkSetFourByteTag('C', 'O', 'L', 'R'),
+    SkSetFourByteTag('C', 'B', 'D', 'T'),
+    SkSetFourByteTag('s', 'b', 'i', 'x'),
+    SkSetFourByteTag('S', 'V', 'G', ' '),
+};
+
+constexpr SkFontTableTag kHeadTag = SkSetFourByteTag('h', 'e', 'a', 'd');
+constexpr SkFontTableTag kHheaTag = SkSetFourByteTag('h', 'h', 'e', 'a');
+constexpr SkFontTableTag kNameTag = SkSetFourByteTag('n', 'a', 'm', 'e');
+constexpr SkFontTableTag kOS2Tag = SkSetFourByteTag('O', 'S', '/', '2');
+
+constexpr SkFontTableTag kNativeOutlineTables[] = {
+    SkSetFourByteTag('C', 'F', 'F', '2'),
+};
+
+// Reads the font's table directory instead of probing for each table: a
+// missing table makes GDI's GetFontData fail, and on failure Skia calls the
+// ensure-accessible hook, which in renderers is a sync IPC to the browser.
+bool HasAnyTable(const SkTypeface& typeface,
+                 base::span<const SkFontTableTag> wanted) {
+  const int count = typeface.countTables();
+  if (count <= 0) {
+    return false;
+  }
+  std::vector<SkFontTableTag> tags(count);
+  tags.resize(std::clamp(typeface.readTableTags(tags), 0, count));
+  return std::ranges::any_of(tags, [wanted](SkFontTableTag tag) {
+    return std::ranges::find(wanted, tag) != wanted.end();
+  });
+}
+
+bool NeedsNativeRasterizer(const SkTypeface& face) {
+  if (HasAnyTable(face, kColorTables) ||
+      HasAnyTable(face, kNativeOutlineTables)) {
+    return true;
+  }
+  std::array<uint8_t, 4> version;
+  return face.getTableData(SkSetFourByteTag('a', 'v', 'a', 'r'), 0,
+                           version.size(), version.data()) == version.size() &&
+         ((version[0] << 8) | version[1]) >= 2;
+}
+
+uint16_t ReadU16(base::span<const uint8_t> data, size_t offset) {
+  return static_cast<uint16_t>((data[offset] << 8) | data[offset + 1]);
+}
+
+// Identifies a face by the start of its head, hhea and OS/2 tables (checksum,
+// dates, metrics), to tell whether GDI opened the face DirectWrite picked.
+// Empty if a table can't be read.
+std::string FaceKey(const SkTypeface& typeface) {
+  std::string key;
+  for (SkFontTableTag tag : {kHeadTag, kHheaTag, kOS2Tag}) {
+    std::array<char, 96> bytes;
+    const size_t size =
+        typeface.getTableData(tag, 0, bytes.size(), bytes.data());
+    if (size == 0) {
+      return std::string();
+    }
+    key.append(bytes.data(), size);
+    key.push_back('|');
+  }
+  return key;
+}
+
+// Whether Blink will take `typeface` for `family`: it compares the family
+// names the typeface lists. (Its other check, getFamilyName(), never matches
+// for GDI typefaces, whose names keep a terminating NUL.)
+bool ListsFamily(const SkTypeface& typeface, const char family[]) {
+  sk_sp<SkTypeface::LocalizedStrings> names{
+      typeface.createFamilyNameIterator()};
+  SkTypeface::LocalizedString name;
+  while (names && names->next(&name)) {
+    if (base::EqualsCaseInsensitiveASCII(name.fString.c_str(), family)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// How GDI names a face: its legacy (name ID 1) family, in which it is the
+// regular, bold, italic or bold italic member (OS/2 fsSelection). GDI families
+// group faces this way, so e.g. a semibold face is a family of its own.
+struct GdiFace {
+  std::string family;
+  SkFontStyle style;
+};
+
+std::optional<GdiFace> GetGdiFace(const SkTypeface& typeface) {
+  const sk_sp<SkData> name = typeface.copyTableData(kNameTag);
+  std::array<uint8_t, 64> os2;
+  if (!name || name->size() < 6 ||
+      typeface.getTableData(kOS2Tag, 0, os2.size(), os2.data()) != os2.size()) {
+    return std::nullopt;
+  }
+  // SAFETY: SkData holds size() bytes.
+  const base::span<const uint8_t> table =
+      UNSAFE_BUFFERS(base::span(name->bytes(), name->size()));
+  const size_t count = ReadU16(table, 2);
+  const size_t storage = ReadU16(table, 4);
+  std::optional<std::u16string> family;
+  for (size_t i = 0; i < count; ++i) {
+    const size_t record = 6 + 12 * i;
+    if (record + 12 > table.size()) {
+      break;
+    }
+    const uint16_t platform = ReadU16(table, record);
+    const uint16_t encoding = ReadU16(table, record + 2);
+    const uint16_t language = ReadU16(table, record + 4);
+    const uint16_t name_id = ReadU16(table, record + 6);
+    const size_t length = ReadU16(table, record + 8);
+    const size_t start = storage + ReadU16(table, record + 10);
+    // Windows platform, Unicode, family name.
+    if (platform != 3 || (encoding != 1 && encoding != 10) || name_id != 1 ||
+        start + length > table.size()) {
+      continue;
+    }
+    std::u16string value;
+    for (size_t j = 0; j + 1 < length; j += 2) {
+      value.push_back(ReadU16(table, start + j));
+    }
+    if (language == 0x0409) {  // English (United States)
+      family = std::move(value);
+      break;
+    }
+    if (!family) {
+      family = std::move(value);
+    }
+  }
+  if (!family || family->empty()) {
+    return std::nullopt;
+  }
+  const uint16_t selection = ReadU16(os2, 62);
+  return GdiFace{
+      base::UTF16ToUTF8(*family),
+      SkFontStyle((selection & (1 << 5)) ? SkFontStyle::kBold_Weight
+                                         : SkFontStyle::kNormal_Weight,
+                  SkFontStyle::kNormal_Width,
+                  (selection & 1) ? SkFontStyle::kItalic_Slant
+                                  : SkFontStyle::kUpright_Slant)};
+}
+
+// The variation position of a variable font's face when it isn't the default
+// instance (e.g. a named instance such as Bahnschrift Light), else empty. GDI
+// draws only the default instance.
+std::vector<Coordinate> NonDefaultVariation(const SkTypeface& typeface) {
+  const int count = typeface.getVariationDesignPosition({});
+  const int axis_count = typeface.getVariationDesignParameters({});
+  if (count <= 0 || axis_count <= 0) {
+    return {};
+  }
+  std::vector<Coordinate> position(count);
+  std::vector<SkFontParameters::Variation::Axis> axes(axis_count);
+  if (typeface.getVariationDesignPosition(position) != count ||
+      typeface.getVariationDesignParameters(axes) != axis_count) {
+    return {};
+  }
+  for (const Coordinate& coordinate : position) {
+    for (const SkFontParameters::Variation::Axis& axis : axes) {
+      if (axis.tag == coordinate.axis && coordinate.value != axis.def) {
+        return position;
+      }
+    }
+  }
+  return {};
+}
+
+// Loads a face's font data into GDI under a private name (for a variable font
+// instance, a static copy of it). The typeface lists the face's own family
+// names first and the requested name after them, since Blink checks the
+// request against that list. Skia extracts the selected TTC face before
+// renaming it, keeping its glyph indices and layout tables intact.
+sk_sp<SkTypeface> LoadIntoGdi(const SkTypeface& face,
+                              const char requested_family[],
+                              const std::vector<Coordinate>& variation) {
+  int ttc_index = 0;
+  std::unique_ptr<SkStreamAsset> stream = face.openStream(&ttc_index);
+  if (!stream || !stream->rewind()) {
+    return nullptr;
+  }
+  sk_sp<SkData> data =
+      SkData::MakeFromStream(stream.get(), stream->getLength());
+
+  std::vector<SkString> names;
+  auto add_name = [&names](const SkString& name) {
+    if (!name.isEmpty() &&
+        std::ranges::none_of(names, [&name](const SkString& known) {
+          return base::EqualsCaseInsensitiveASCII(known.c_str(), name.c_str());
+        })) {
+      names.push_back(name);
+    }
+  };
+  SkString own_family;
+  face.getFamilyName(&own_family);
+  add_name(own_family);
+  if (sk_sp<SkTypeface::LocalizedStrings> family_names{
+          face.createFamilyNameIterator()}) {
+    SkTypeface::LocalizedString name;
+    while (family_names->next(&name)) {
+      add_name(name.fString);
+    }
+  }
+  if (requested_family) {
+    add_name(SkString(requested_family));
+  }
+  return SkCreateGdiTypefaceFromData(
+      std::move(data), ttc_index, names.data(), static_cast<int>(names.size()),
+      {variation.data(), static_cast<int>(variation.size())});
+}
+
+class GdiFontManager final : public SkFontMgr {
+ public:
+  GdiFontManager(sk_sp<SkFontMgr> gdi,
+                 sk_sp<SkFontMgr> dwrite,
+                 bool fonts_like_directwrite)
+      : gdi_(std::move(gdi)),
+        dwrite_(std::move(dwrite)),
+        fonts_like_directwrite_(fonts_like_directwrite) {}
+
+  ~GdiFontManager() override {
+    base::AutoLock lock(lock_);
+    for (WeakTypefaces* typefaces : {&chosen_, &loaded_}) {
+      for (auto& [key, typeface] : *typefaces) {
+        typeface->weak_unref();
+      }
+    }
+  }
+
+ protected:
+  int onCountFamilies() const override { return gdi_->countFamilies(); }
+
+  void onGetFamilyName(int index, SkString* family_name) const override {
+    gdi_->getFamilyName(index, family_name);
+  }
+
+  sk_sp<SkFontStyleSet> onCreateStyleSet(int index) const override {
+    return gdi_->createStyleSet(index);
+  }
+
+  sk_sp<SkFontStyleSet> onMatchFamily(const char family_name[]) const override {
+    return gdi_->matchFamily(family_name);
+  }
+
+  sk_sp<SkTypeface> onMatchFamilyStyle(
+      const char family_name[],
+      const SkFontStyle& style) const override {
+    sk_sp<SkTypeface> typeface = MatchGdiFamilyStyle(family_name, style);
+    if (fonts_like_directwrite_ && family_name) {
+      if (sk_sp<SkTypeface> face =
+              dwrite_->matchFamilyStyle(family_name, style)) {
+        return GdiTypefaceForFace(std::move(face), family_name, style,
+                                  std::move(typeface));
+      }
+      // DirectWrite doesn't know the font (e.g. bitmap .fon fonts).
+      return typeface;
+    }
+    if (typeface && IsColorFont(*typeface)) {
+      if (sk_sp<SkTypeface> color =
+              dwrite_->matchFamilyStyle(family_name, style)) {
+        return color;
+      }
+    }
+    return typeface;
+  }
+
+  // GDI has no per-character fallback, so DirectWrite picks the font and the
+  // same family is then opened through GDI. Keep the original native face
+  // when GDI cannot render the character.
+  sk_sp<SkTypeface> onMatchFamilyStyleCharacter(
+      const char family_name[],
+      const SkFontStyle& style,
+      const char* bcp47[],
+      int bcp47_count,
+      SkUnichar character) const override {
+    sk_sp<SkTypeface> fallback = dwrite_->matchFamilyStyleCharacter(
+        family_name, style, bcp47, bcp47_count, character);
+    if (!fallback) {
+      return nullptr;
+    }
+    SkString fallback_family;
+    fallback->getFamilyName(&fallback_family);
+    sk_sp<SkTypeface> typeface;
+    if (fonts_like_directwrite_) {
+      // FontDataManager makes a new typeface on every fallback call, so check
+      // it directly rather than caching by its id, and look the face up the
+      // way Blink does next, by family and style, which FontDataManager
+      // caches (so the face is loaded into GDI once).
+      if (HasAnyTable(*fallback, kColorTables)) {
+        return fallback;
+      }
+      typeface =
+          matchFamilyStyle(fallback_family.c_str(), fallback->fontStyle());
+    } else {
+      if (IsColorFont(*fallback)) {
+        return fallback;
+      }
+      typeface =
+          MatchGdiFamilyStyle(fallback_family.c_str(), fallback->fontStyle());
+    }
+    if (typeface && typeface->unicharToGlyph(character)) {
+      return typeface;
+    }
+    // DirectWrite already found coverage. Preserve that exact face if GDI
+    // cannot open it or maps it to a face without the requested glyph.
+    return fallback;
+  }
+
+  // Data fonts prefer GDI, with native fallbacks for unsupported formats or
+  // failed loads. This also covers local(), which bypasses Blink's web-font
+  // format dispatcher.
+  sk_sp<SkTypeface> onMakeFromData(sk_sp<SkData> data,
+                                   int ttc_index) const override {
+    SkFontArguments args;
+    args.setCollectionIndex(ttc_index);
+    return MakeFromFontData(std::move(data), args);
+  }
+
+  sk_sp<SkTypeface> onMakeFromStreamIndex(std::unique_ptr<SkStreamAsset> stream,
+                                          int ttc_index) const override {
+    if (!stream || !stream->rewind()) {
+      return nullptr;
+    }
+    return onMakeFromData(
+        SkData::MakeFromStream(stream.get(), stream->getLength()), ttc_index);
+  }
+
+  sk_sp<SkTypeface> onMakeFromStreamArgs(
+      std::unique_ptr<SkStreamAsset> stream,
+      const SkFontArguments& args) const override {
+    if (!stream || !stream->rewind()) {
+      return nullptr;
+    }
+    return MakeFromFontData(
+        SkData::MakeFromStream(stream.get(), stream->getLength()), args);
+  }
+
+  sk_sp<SkTypeface> onMakeFromFile(const char path[],
+                                   int ttc_index) const override {
+    std::unique_ptr<SkStreamAsset> stream = SkStream::MakeFromFile(path);
+    if (!stream) {
+      return nullptr;
+    }
+    return onMakeFromStreamIndex(std::move(stream), ttc_index);
+  }
+
+  sk_sp<SkTypeface> onLegacyMakeTypeface(const char family_name[],
+                                         SkFontStyle style) const override {
+    sk_sp<SkTypeface> typeface = gdi_->legacyMakeTypeface(family_name, style);
+    if (typeface && IsColorFont(*typeface)) {
+      if (sk_sp<SkTypeface> color =
+              dwrite_->legacyMakeTypeface(family_name, style)) {
+        return color;
+      }
+    }
+    return typeface;
+  }
+
+ private:
+  // Both CSS local() and downloaded fonts enter here. Parse the selected face
+  // first, preserving collection, variation and palette arguments. Never match
+  // these private fonts by name against an installed font with the same name.
+  sk_sp<SkTypeface> MakeFromFontData(sk_sp<SkData> data,
+                                     const SkFontArguments& args) const {
+    if (!data) {
+      return nullptr;
+    }
+    sk_sp<SkTypeface> face =
+        dwrite_->makeFromStream(std::make_unique<SkMemoryStream>(data), args);
+    if (!face) {
+      return SkTypeface_Make_Fontations(std::move(data), args);
+    }
+    if (NeedsNativeRasterizer(*face)) {
+      if (sk_sp<SkTypeface> native = SkTypeface_Make_Fontations(data, args)) {
+        return native;
+      }
+      return face;
+    }
+    if (sk_sp<SkTypeface> gdi =
+            LoadIntoGdi(*face, nullptr, NonDefaultVariation(*face))) {
+      return gdi;
+    }
+    return face;
+  }
+
+  // Opens a family through GDI. GDI's family enumeration skips fonts without
+  // an ANSI charset, such as Wingdings and Symbol, so those are opened by name,
+  // unless GDI silently maps the name to another font.
+  sk_sp<SkTypeface> MatchGdiFamilyStyle(const char family_name[],
+                                        const SkFontStyle& style) const {
+    if (sk_sp<SkTypeface> typeface =
+            gdi_->matchFamilyStyle(family_name, style)) {
+      return typeface;
+    }
+    if (!family_name) {
+      return nullptr;
+    }
+    sk_sp<SkTypeface> typeface = gdi_->legacyMakeTypeface(family_name, style);
+    SkString gdi_family;
+    if (typeface) {
+      typeface->getFamilyName(&gdi_family);
+    }
+    if (!base::EqualsCaseInsensitiveASCII(gdi_family.c_str(), family_name)) {
+      return nullptr;
+    }
+    return typeface;
+  }
+
+  // The face DirectWrite picked for a page's request (`face`), drawn by GDI:
+  // GDI's own match if it is the same face, else the face opened through its
+  // GDI family, else its data loaded into GDI. A GDI typeface is used only if
+  // it lists the requested family, as Blink checks that (GDI also opens
+  // variable font instances by names the font itself doesn't list). Color
+  // fonts stay on DirectWrite.
+  //
+  // Blink asks again for every size, and FontDataManager hands out a new
+  // typeface for every new request, so results are cached by the face's
+  // content (plus variation, requested family, and requested style), and a
+  // font loaded into GDI is shared by the
+  // styles that resolve to it. Both are held weakly, so a loaded font is freed
+  // once nothing draws with it (a few recent ones are kept alive).
+  sk_sp<SkTypeface> GdiTypefaceForFace(sk_sp<SkTypeface> face,
+                                       const char requested_family[],
+                                       const SkFontStyle& requested_style,
+                                       sk_sp<SkTypeface> gdi_match) const {
+    if (NeedsNativeRasterizer(*face)) {
+      return face;
+    }
+    const std::string face_key = FaceKey(*face);
+    const std::vector<Coordinate> variation = NonDefaultVariation(*face);
+    std::string instance_key = face_key;
+    for (const Coordinate& coordinate : variation) {
+      base::StrAppend(&instance_key,
+                      {base::NumberToString(coordinate.axis), "=",
+                       base::NumberToString(coordinate.value), ";"});
+    }
+    // Collection faces can share head/hhea/OS/2 metrics while having different
+    // regional glyphs. Do not share a cached face across requested families.
+    base::StrAppend(&instance_key, {"|", base::ToLowerASCII(requested_family)});
+    const std::string chosen_key = base::StrCat(
+        {instance_key, "|", base::NumberToString(requested_style.weight()), "/",
+         base::NumberToString(requested_style.width()), "/",
+         base::NumberToString(static_cast<int>(requested_style.slant()))});
+    const bool cacheable = !face_key.empty();
+    if (cacheable) {
+      base::AutoLock lock(lock_);
+      if (sk_sp<SkTypeface> typeface = FindLocked(chosen_, chosen_key)) {
+        KeepRecentLocked(typeface);
+        return typeface;
+      }
+    }
+
+    sk_sp<SkTypeface> typeface;
+    if (variation.empty() && cacheable) {
+      auto is_face = [&face_key,
+                      requested_family](const sk_sp<SkTypeface>& candidate) {
+        return candidate && FaceKey(*candidate) == face_key &&
+               ListsFamily(*candidate, requested_family);
+      };
+      if (is_face(gdi_match)) {
+        typeface = gdi_match;
+      } else if (std::optional<GdiFace> gdi_face = GetGdiFace(*face)) {
+        sk_sp<SkTypeface> candidate =
+            gdi_->legacyMakeTypeface(gdi_face->family.c_str(), gdi_face->style);
+        if (is_face(candidate)) {
+          typeface = std::move(candidate);
+        }
+      }
+    }
+    if (!typeface && cacheable) {
+      base::AutoLock lock(lock_);
+      typeface = FindLocked(loaded_, instance_key);
+    }
+    if (!typeface) {
+      typeface = LoadIntoGdi(*face, requested_family, variation);
+      if (typeface && cacheable) {
+        base::AutoLock lock(lock_);
+        StoreLocked(loaded_, instance_key, typeface);
+      }
+    }
+    if (!typeface) {
+      return face;
+    }
+    if (cacheable) {
+      base::AutoLock lock(lock_);
+      StoreLocked(chosen_, chosen_key, typeface);
+      KeepRecentLocked(typeface);
+    }
+    return typeface;
+  }
+
+  using WeakTypefaces = absl::flat_hash_map<std::string, SkTypeface*>;
+
+  // The live typeface stored under `key`, if any; expired entries are dropped.
+  static sk_sp<SkTypeface> FindLocked(WeakTypefaces& typefaces,
+                                      const std::string& key) {
+    auto it = typefaces.find(key);
+    if (it == typefaces.end()) {
+      return nullptr;
+    }
+    if (it->second->try_ref()) {
+      return sk_sp<SkTypeface>(it->second);
+    }
+    it->second->weak_unref();
+    typefaces.erase(it);
+    return nullptr;
+  }
+
+  static void StoreLocked(WeakTypefaces& typefaces,
+                          const std::string& key,
+                          const sk_sp<SkTypeface>& typeface) {
+    static constexpr size_t kSweepAt = 64;
+    if (typefaces.size() >= kSweepAt) {
+      absl::erase_if(typefaces, [](const auto& entry) {
+        if (!entry.second->weak_expired()) {
+          return false;
+        }
+        entry.second->weak_unref();
+        return true;
+      });
+    }
+    typeface->weak_ref();
+    auto [it, inserted] = typefaces.try_emplace(key, typeface.get());
+    if (!inserted) {
+      it->second->weak_unref();
+      it->second = typeface.get();
+    }
+  }
+
+  void KeepRecentLocked(const sk_sp<SkTypeface>& typeface) const
+      EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+    static constexpr size_t kRecent = 16;
+    auto it = std::ranges::find(recent_, typeface);
+    if (it != recent_.end()) {
+      std::rotate(it, it + 1, recent_.end());
+      return;
+    }
+    if (recent_.size() == kRecent) {
+      recent_.erase(recent_.begin());
+    }
+    recent_.push_back(typeface);
+  }
+
+  // GDI draws color glyph tables as plain outlines, so color fonts such as
+  // Segoe UI Emoji stay on DirectWrite. Cached because UI text asks for the
+  // same typefaces on every layout.
+  bool IsColorFont(const SkTypeface& typeface) const {
+    {
+      base::AutoLock lock(lock_);
+      auto it = is_color_font_.find(typeface.uniqueID());
+      if (it != is_color_font_.end()) {
+        return it->second;
+      }
+    }
+    const bool is_color = HasAnyTable(typeface, kColorTables);
+    base::AutoLock lock(lock_);
+    is_color_font_.emplace(typeface.uniqueID(), is_color);
+    return is_color;
+  }
+
+  const sk_sp<SkFontMgr> gdi_;
+  const sk_sp<SkFontMgr> dwrite_;
+  const bool fonts_like_directwrite_;
+
+  mutable base::Lock lock_;
+  mutable absl::flat_hash_map<SkTypefaceID, bool> is_color_font_
+      GUARDED_BY(lock_);
+  // Web content, held weakly (see GdiTypefaceForFace): the typeface chosen per
+  // face, variation, name and style, and the fonts loaded into GDI per face,
+  // variation and name. `recent_` keeps the last few alive.
+  mutable WeakTypefaces chosen_ GUARDED_BY(lock_);
+  mutable WeakTypefaces loaded_ GUARDED_BY(lock_);
+  mutable std::vector<sk_sp<SkTypeface>> recent_ GUARDED_BY(lock_);
+};
+
+}  // namespace
+
+sk_sp<SkFontMgr> CreateGdiFontManager(sk_sp<SkFontMgr> dwrite,
+                                      bool fonts_like_directwrite) {
+  return sk_make_sp<GdiFontManager>(SkFontMgr_New_GDI(), std::move(dwrite),
+                                    fonts_like_directwrite);
+}
