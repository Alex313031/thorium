+#ifndef UI_GFX_WIN_GDI_FONT_MANAGER_H_
+#define UI_GFX_WIN_GDI_FONT_MANAGER_H_
+
+#include "base/component_export.h"
+#include "third_party/skia/include/core/SkRefCnt.h"
+
+class SkFontMgr;
+
+namespace gfx {
+namespace win {
+
+// Returns a font manager that draws text through GDI, so GDI hooks such as
+// MacType apply to it. `dwrite` picks per-character fallback fonts (which are
+// then opened through GDI) and draws color system fonts such as emoji. Native
+// rendering is retained when GDI cannot load a face or cover a character.
+//
+// With `fonts_like_directwrite` (web content), `dwrite` also decides which
+// installed font face a family request gets, as in other browsers, rather
+// than GDI's font mapper with its registry settings (FontSubstitutes, hidden
+// fonts) and its regular/bold-only families. GDI still draws: the face is
+// opened by name when GDI has the same one, otherwise its data is loaded into
+// GDI, falling back to the native face if necessary. Without it (the browser
+// UI), fonts follow the system's GDI settings.
+COMPONENT_EXPORT(GFX)
+sk_sp<SkFontMgr> CreateGdiFontManager(sk_sp<SkFontMgr> dwrite,
+                                      bool fonts_like_directwrite = false);
+
+}  // namespace win
+}  // namespace gfx
+
+#endif  // UI_GFX_WIN_GDI_FONT_MANAGER_H_
