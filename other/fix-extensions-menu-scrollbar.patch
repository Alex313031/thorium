diff --git a/chrome/browser/ui/views/extensions/extensions_menu_scroll_view.cc b/chrome/browser/ui/views/extensions/extensions_menu_scroll_view.cc
new file mode 100644
index 0000000000000..53f67fd3568e2
--- /dev/null
+++ b/chrome/browser/ui/views/extensions/extensions_menu_scroll_view.cc
@@ -0,0 +1,109 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/views/extensions/extensions_menu_scroll_view.h"
+
+#include "build/build_config.h"
+#include "ui/base/metadata/metadata_impl_macros.h"
+
+#if BUILDFLAG(IS_WIN)
+#include <algorithm>
+#include <memory>
+
+#include "base/functional/bind.h"
+#include "ui/color/color_provider_key.h"
+#include "ui/native_theme/native_theme.h"
+#include "ui/native_theme/os_settings_provider.h"
+#include "ui/views/controls/scrollbar/overlay_scroll_bar.h"
+#include "ui/views/style/platform_style.h"
+
+namespace {
+
+class ExtensionsMenuOverlayScrollBar : public views::OverlayScrollBar {
+  METADATA_HEADER(ExtensionsMenuOverlayScrollBar, views::OverlayScrollBar)
+
+ public:
+  explicit ExtensionsMenuOverlayScrollBar(int vertical_inset)
+      : OverlayScrollBar(views::ScrollBar::Orientation::kVertical),
+        vertical_inset_(std::max(0, vertical_inset)) {}
+
+  gfx::Insets GetInsets() const override {
+    // Keep both ends clear of the bubble's rounded client clip. Insets are
+    // part of the track geometry, so sizing and dragging use the same range.
+    // Preserve space for a minimum-sized thumb in a very short scroll view.
+    const int max_inset =
+        std::max(0, (height() - GetThumb()->GetPreferredSize({}).height()) / 2);
+    return OverlayScrollBar::GetInsets() +
+           gfx::Insets::VH(std::min(vertical_inset_, max_inset), 0);
+  }
+
+ private:
+  const int vertical_inset_;
+};
+
+BEGIN_METADATA(ExtensionsMenuOverlayScrollBar)
+END_METADATA
+
+}  // namespace
+#endif
+
+ExtensionsMenuScrollView::ExtensionsMenuScrollView(int vertical_scrollbar_inset)
+#if BUILDFLAG(IS_WIN)
+    : vertical_scrollbar_inset_(vertical_scrollbar_inset)
+#endif
+{
+  SetHorizontalScrollBarMode(ScrollBarMode::kDisabled);
+  UpdateScrollBar();
+#if BUILDFLAG(IS_WIN)
+  // Observe OS settings directly: the web-content OverlayScrollbar feature can
+  // prevent a change to the OS auto-hide setting from changing NativeTheme.
+  os_settings_subscription_ =
+      ui::OsSettingsProvider::RegisterOsSettingsChangedCallback(
+          base::BindRepeating(
+              [](ExtensionsMenuScrollView* view, bool /*force_notify*/) {
+                view->UpdateScrollBar();
+              },
+              base::Unretained(this)));
+#endif
+}
+
+ExtensionsMenuScrollView::~ExtensionsMenuScrollView() = default;
+
+void ExtensionsMenuScrollView::OnThemeChanged() {
+  views::ScrollView::OnThemeChanged();
+  UpdateScrollBar();
+}
+
+void ExtensionsMenuScrollView::UpdateScrollBar() {
+#if BUILDFLAG(IS_WIN)
+  const auto& settings = ui::OsSettingsProvider::Get();
+  const ui::NativeTheme* theme =
+      GetWidget() ? GetNativeTheme()
+                  : ui::NativeTheme::GetInstanceForNativeUi();
+  const bool use_overlay =
+      settings.PrefersOverlayScrollbars() && !settings.ForcedColorsActive() &&
+      settings.PreferredContrast() !=
+          ui::NativeTheme::PreferredContrast::kMore &&
+      theme->forced_colors() == ui::ColorProviderKey::ForcedColors::kNone &&
+      theme->preferred_contrast() != ui::NativeTheme::PreferredContrast::kMore;
+  if (vertical_scroll_bar()->OverlapsContent() == use_overlay) {
+    return;
+  }
+
+  if (use_overlay) {
+    SetVerticalScrollBar(std::make_unique<ExtensionsMenuOverlayScrollBar>(
+        vertical_scrollbar_inset_));
+  } else {
+    SetVerticalScrollBar(views::PlatformStyle::CreateScrollBar(
+        views::ScrollBar::Orientation::kVertical));
+  }
+  // The ScrollView retains its contents and scroll offset. Recompute layout
+  // because overlay scrollbars do not reserve space beside the viewport.
+  PreferredSizeChanged();
+  SchedulePaint();
+#endif
+}
+
+BEGIN_METADATA(ExtensionsMenuScrollView)
+END_METADATA
