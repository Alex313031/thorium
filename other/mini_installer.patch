+namespace installer {
+namespace {
+
+struct InstalledProcess {
+  base::Process process;
+  RM_UNIQUE_PROCESS identity;
+  DWORD parent_pid;
+};
+
+bool HasExited(const InstalledProcess& process) {
+  return ::WaitForSingleObject(process.process.Handle(), 0) == WAIT_OBJECT_0;
+}
+
+std::optional<std::vector<InstalledProcess>> FindInstalledProcesses(
+    const base::FilePath& target_path) {
+  std::vector<InstalledProcess> processes;
+  const base::FilePath executable_path = target_path.Append(kChromeExe);
+  base::NamedProcessIterator iterator(kChromeExe, nullptr);
+  while (const base::ProcessEntry* entry = iterator.NextProcessEntry()) {
+    // Do not require termination rights to request a cooperative shutdown.
+    // Keep this handle for waiting and capture the creation time for any later
+    // termination attempt, so a reused PID cannot target a different process.
+    base::Process process(
+        ::OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | SYNCHRONIZE, FALSE,
+                      entry->th32ProcessID));
+    if (!process.IsValid()) {
+      if (::GetLastError() == ERROR_INVALID_PARAMETER) {
+        continue;
+      }
+      PLOG(ERROR) << "Cannot inspect browser process " << entry->th32ProcessID;
+      return std::nullopt;
+    }
+    if (::WaitForSingleObject(process.Handle(), 0) == WAIT_OBJECT_0) {
+      continue;
+    }
+    std::wstring path(32768, L'\0');
+    DWORD path_length = static_cast<DWORD>(path.size());
+    if (!::QueryFullProcessImageNameW(process.Handle(), 0, path.data(),
+                                      &path_length)) {
+      const DWORD error = ::GetLastError();
+      if (::WaitForSingleObject(process.Handle(), 0) == WAIT_OBJECT_0) {
+        continue;
+      }
+      LOG(ERROR) << "Cannot query browser process path: " << error;
+      return std::nullopt;
+    }
+    path.resize(path_length);
+    if (!base::FilePath::CompareEqualIgnoreCase(executable_path.value(),
+                                                path)) {
+      continue;
+    }
+    RM_UNIQUE_PROCESS identity = {};
+    identity.dwProcessId = entry->th32ProcessID;
+    FILETIME exit_time, kernel_time, user_time;
+    if (!::GetProcessTimes(process.Handle(), &identity.ProcessStartTime,
+                           &exit_time, &kernel_time, &user_time)) {
+      PLOG(ERROR) << "Cannot identify installed browser process";
+      return std::nullopt;
+    }
+    processes.push_back({std::move(process), identity, entry->parent_pid()});
+  }
+  if (::GetLastError() != ERROR_NO_MORE_FILES) {
+    PLOG(ERROR) << "Cannot enumerate browser processes";
+    return std::nullopt;
+  }
+  return processes;
+}
+
+void RequestUpdateShutdown(const std::vector<InstalledProcess>& processes) {
+  std::vector<RM_UNIQUE_PROCESS> applications;
+  for (const auto& process : processes) {
+    if (HasExited(process)) {
+      continue;
+    }
+    // Notify parent browsers first. Do not stop their renderers/GPU processes
+    // while the browser is still saving its profile. A later pass discovers
+    // any remaining roots, including a browser launched by another browser.
+    const bool has_parent = std::ranges::any_of(
+        processes, [&process](const InstalledProcess& candidate) {
+          return candidate.identity.dwProcessId == process.parent_pid &&
+                 ::CompareFileTime(&candidate.identity.ProcessStartTime,
+                                   &process.identity.ProcessStartTime) <= 0 &&
+                 !HasExited(candidate);
+        });
+    if (!has_parent) {
+      applications.push_back(process.identity);
+    }
+  }
+  if (applications.empty()) {
+    return;
+  }
+
+  DWORD session = 0;
+  wchar_t session_key[CCH_RM_SESSION_KEY + 1] = {};
+  DWORD error = ::RmStartSession(&session, 0, session_key);
+  if (error != ERROR_SUCCESS) {
+    LOG(WARNING) << "Cannot start Restart Manager session: " << error;
+    return;
+  }
+  base::ScopedClosureRunner end_session(
+      base::BindOnce([](DWORD handle) { ::RmEndSession(handle); }, session));
+  error = ::RmRegisterResources(session, 0, nullptr,
+                                static_cast<UINT>(applications.size()),
+                                applications.data(), 0, nullptr);
+  if (error == ERROR_SUCCESS) {
+    // Sends WM_QUERYENDSESSION/WM_ENDSESSION with ENDSESSION_CLOSEAPP.
+    // Chromium's browser and background tray call SessionEnding(), saving
+    // the exit type and committing preferences before the process exits.
+    // Force is deliberately deferred until all shutdown passes have finished.
+    error = ::RmShutdown(session, 0, nullptr);
+  }
+  if (error != ERROR_SUCCESS) {
+    LOG(WARNING) << "Restart Manager update shutdown incomplete: " << error;
+  }
+}
+
+void WaitForExit(const std::vector<InstalledProcess>& processes,
+                 base::TimeDelta timeout) {
+  const base::TimeTicks deadline = base::TimeTicks::Now() + timeout;
+  for (const auto& process : processes) {
+    process.process.WaitForExitWithTimeout(
+        std::max(base::TimeDelta(), deadline - base::TimeTicks::Now()),
+        nullptr);
+  }
+}
+
+void ForceExit(const InstalledProcess& process) {
+  if (HasExited(process)) {
+    return;
+  }
+  base::Process terminable(
+      ::OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_TERMINATE,
+                    FALSE, process.identity.dwProcessId));
+  if (!terminable.IsValid()) {
+    PLOG(WARNING) << "Cannot open browser process for forced shutdown";
+    return;
+  }
+  FILETIME creation_time, exit_time, kernel_time, user_time;
+  if (!::GetProcessTimes(terminable.Handle(), &creation_time, &exit_time,
+                         &kernel_time, &user_time) ||
+      ::CompareFileTime(&creation_time, &process.identity.ProcessStartTime) !=
+          0) {
+    LOG(WARNING) << "Browser process identity changed before forced shutdown";
+    return;
+  }
+  LOG(WARNING) << "Forcing installed browser process to exit: "
+               << process.identity.dwProcessId
+               << "; unsaved session state may require crash recovery";
+  terminable.Terminate(/*exit_code=*/0, /*wait=*/false);
+}
+
+}  // namespace
+
+bool CloseInstalledBrowser(const base::FilePath& target_path) {
+  // Re-enumerate after each pass: shutting down a parent can expose a second
+  // browser root or leave child processes behind. Bound retries so an external
+  // program continually relaunching the browser cannot hang setup forever.
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    auto processes = FindInstalledProcesses(target_path);
+    if (!processes) {
+      return false;
+    }
+    if (processes->empty()) {
+      return true;
+    }
+    RequestUpdateShutdown(*processes);
+    WaitForExit(*processes, base::Seconds(5));
+  }
+
+  for (int attempt = 0; attempt < 2; ++attempt) {
+    auto processes = FindInstalledProcesses(target_path);
+    if (!processes) {
+      return false;
+    }
+    if (processes->empty()) {
+      return true;
+    }
+    for (const auto& process : *processes) {
+      ForceExit(process);
+    }
+    WaitForExit(*processes, base::Seconds(5));
+  }
+
+  const auto remaining = FindInstalledProcesses(target_path);
+  if (!remaining || !remaining->empty()) {
+    LOG(ERROR) << "Installed browser processes remain; cannot replace files";
+    return false;
+  }
+  return true;
+}
+
+}  // namespace installer
