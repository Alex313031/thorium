+HRESULT CALLBACK TaskDialogCallbackProc(HWND hwnd,
+                                        UINT notification,
+                                        WPARAM button,
+                                        LPARAM,
+                                        LONG_PTR callback_data) {
+  auto* state = reinterpret_cast<InstallerDialogState*>(callback_data);
+  if (!state) {
+    return S_OK;
+  }
+
+  if (notification == TDN_CREATED) {
+    state->dialog = hwnd;
+    SendMessageW(hwnd, TDM_SET_MARQUEE_PROGRESS_BAR, TRUE, 0);
+    SendMessageW(hwnd, TDM_SET_PROGRESS_BAR_MARQUEE, FALSE, 0);
+    return S_OK;
+  }
+
+  if (notification == TDN_TIMER && state->install_started &&
+      state->install_finished.load(std::memory_order_acquire) &&
+      !state->result_shown) {
+    state->result_shown = true;
+    ShowInstallResult(state);
+    return S_OK;
+  }
+
+  if (notification != TDN_BUTTON_CLICKED) {
+    return S_OK;
+  }
+
+  if (button == IDYES && !state->install_started) {
+    state->install_started = true;
+    SendMessageW(hwnd, TDM_SET_PROGRESS_BAR_MARQUEE, TRUE, 30);
+    SendMessageW(hwnd, TDM_SET_ELEMENT_TEXT, TDE_CONTENT,
+                 reinterpret_cast<LPARAM>(state->installing_message.c_str()));
+    SendMessageW(hwnd, TDM_ENABLE_BUTTON, IDYES, FALSE);
+    SendMessageW(hwnd, TDM_ENABLE_BUTTON, IDNO, FALSE);
+
+    state->install_thread = reinterpret_cast<HANDLE>(
+        _beginthreadex(nullptr, 0, InstallThreadProc, state, 0, nullptr));
+    if (!state->install_thread) {
+      state->install_result = ProcessExitResult(GENERIC_ERROR, errno);
+      state->install_finished.store(true, std::memory_order_release);
+      state->result_shown = true;
+      ShowInstallResult(state);
+    }
+    return S_FALSE;
+  }
+
+  if (state->install_started &&
+      !state->install_finished.load(std::memory_order_acquire)) {
+    return S_FALSE;
+  }
+  return S_OK;
+}
