+bool MenuController::MoveSelectionToAdjacentColumn(bool forward) {
+  MenuItemView* item = pending_state_.item;
+  if (!item || !item->GetParentMenuItem() || item->SubmenuIsShowing() ||
+      (forward && item->HasSubmenu() && item->GetEnabled())) {
+    // Opening/closing a folder takes precedence over moving between columns.
+    return false;
+  }
+  SubmenuView* submenu = item->GetParentMenuItem()->GetSubmenu();
+  MenuItemView* adjacent = submenu->GetAdjacentColumnMenuItem(item, forward);
+  if (!adjacent) {
+    return false;
+  }
+  SetSelection(adjacent, SELECTION_UPDATE_IMMEDIATELY);
+  return true;
+}
