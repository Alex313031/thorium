+SubmenuView::MultiColumnLayout SubmenuView::CalculateMultiColumnLayout(
+    int available_width) const {
+  MultiColumnLayout result;
+  result.child_bounds.resize(children().size());
+  const gfx::Insets insets = GetInsets();
+  const int content_width = std::max(1, available_width - insets.width());
+  // Row heights are measured below at the capped column width, so computing
+  // the full single-column height here would duplicate that work.
+  const int natural_width =
+      CalculateSingleColumnPreferredSize(/*include_height=*/false).width() -
+      insets.width();
