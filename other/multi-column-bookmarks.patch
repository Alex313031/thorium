+      std::min(content_width,
+               std::min(max_column_width_,
+                        std::max(kMinimumMenuColumnWidth, natural_width)));
+  const int max_columns = allow_multiple_columns_
+                              ? std::max(1, (content_width + kMenuColumnGap) /
+                                                (column_width + kMenuColumnGap))
+                              : 1;
+
+  struct Row {
+    size_t child_index;
+    int height;
+    int padding;
+  };
+  std::vector<Row> rows;
+  rows.reserve(children().size());
+  int total_height = 0;
+  int tallest_row = 0;
+  bool has_scroll_step = false;
+  bool previous_lower_separator = false;
+  bool previous_item_separator = false;
+  for (size_t i = 0; i < children().size(); ++i) {
+    const View* child = children()[i];
+    if (!child->GetVisible()) {
+      continue;
+    }
+    const auto* separator = AsViewClass<MenuSeparator>(child);
+    const bool item_separator =
+        separator && separator->GetType() == ui::MENU_ITEM_SEPARATOR;
+    const int padding =
+        !rows.empty() && !previous_lower_separator &&
+                !previous_item_separator &&
+                (!separator || (separator->GetType() != ui::UPPER_SEPARATOR &&
+                                !item_separator))
+            ? MenuConfig::instance().between_item_vertical_padding
+            : 0;
+    const int height = std::max(0, child->GetHeightForWidth(column_width));
+    if (!has_scroll_step && height > 0 && IsViewClass<MenuItemView>(child)) {
+      // Reuse the row measurement so wheel events never have to scan items or
+      // create a temporary menu item to determine their scroll distance.
+      result.scroll_step = std::max<int>(
+          1, base::ClampAdd(
+                 height, MenuConfig::instance().between_item_vertical_padding));
+      has_scroll_step = true;
+    }
+    rows.push_back({i, height, padding});
+    total_height = base::ClampAdd(total_height, padding, height);
+    tallest_row = std::max(tallest_row, height);
+    previous_lower_separator =
+        separator && separator->GetType() == ui::LOWER_SEPARATOR;
+    previous_item_separator = item_separator;
+  }
+  if (rows.empty()) {
+    result.size = gfx::Size(column_width + insets.width(), insets.height());
+    return result;
+  }
+
+  const auto columns_for_height = [&rows, max_columns](int height_limit) {
+    int columns = 1;
+    int height = 0;
+    bool first_row = true;
+    for (const auto& row : rows) {
+      const int padding = first_row ? 0 : row.padding;
+      if (!first_row &&
+          base::ClampAdd(height, padding, row.height) > height_limit) {
+        ++columns;
+        if (columns > max_columns) {
+          return columns;
+        }
+        height = row.height;
+      } else {
+        height = base::ClampAdd(height, padding, row.height);
+      }
+      first_row = false;
+    }
+    return columns;
+  };
+
+  // Fill each column down to the available height. If all columns still cannot
+  // hold the menu, find the smallest taller column height that can. This keeps
+  // overflow spread across all columns, instead of putting it in the last one.
+  int column_height =
+      std::max({1, tallest_row,
+                multi_column_available_size_.height() - insets.height()});
+  if (max_columns == 1) {
+    column_height = std::max(column_height, total_height);
+  } else if (columns_for_height(column_height) > max_columns) {
+    int high = total_height;
+    while (column_height < high) {
+      const int middle = column_height + (high - column_height) / 2;
+      if (columns_for_height(middle) > max_columns) {
+        column_height = middle + 1;
+      } else {
+        high = middle;
+      }
+    }
+  }
+
+  int column = 0;
+  int height = 0;
+  int max_height = 0;
+  bool first_row = true;
+  for (const auto& row : rows) {
+    int padding = first_row ? 0 : row.padding;
+    if (!first_row &&
+        base::ClampAdd(height, padding, row.height) > column_height) {
+      ++column;
+      height = 0;
+      padding = 0;
+    }
+    height = base::ClampAdd(height, padding);
+    result.child_bounds[row.child_index] =
+        gfx::Rect(insets.left() + column * (column_width + kMenuColumnGap),
+                  insets.top() + height, column_width, row.height);
+    height = base::ClampAdd(height, row.height);
+    max_height = std::max(max_height, height);
+    first_row = false;
+  }
+  result.column_count = column + 1;
+  result.size = gfx::Size(result.column_count * column_width +
+                              column * kMenuColumnGap + insets.width(),
+                          max_height + insets.height());
+  return result;
+}
