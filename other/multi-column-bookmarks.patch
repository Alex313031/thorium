+MenuItemView* SubmenuView::GetAdjacentColumnMenuItem(MenuItemView* item,
+                                                     bool forward) {
+  if (!use_multiple_columns_ || multi_column_count_ <= 1 ||
+      item->parent() != this) {
+    return nullptr;
+  }
+  MenuItemView* best = nullptr;
+  for (View* child : children()) {
+    auto* candidate = AsViewClass<MenuItemView>(child);
+    if (!candidate || IsViewClass<EmptyMenuMenuItem>(candidate) ||
+        !candidate->IsTraversableByKeyboard() ||
+        (forward ? candidate->x() <= item->x() : candidate->x() >= item->x())) {
+      continue;
+    }
+    const auto distance = [item](const MenuItemView* target) {
+      return std::pair(std::abs(target->x() - item->x()),
+                       std::abs(target->bounds().CenterPoint().y() -
+                                item->bounds().CenterPoint().y()));
+    };
+    if (!best || distance(candidate) < distance(best)) {
+      best = candidate;
+    }
+  }
+  return best;
+}
+
+MenuItemView* SubmenuView::GetMenuItemBeforeColumnSpace(
+    const gfx::Point& point) {
+  if (!use_multiple_columns_ || multi_column_count_ <= 1 ||
+      !GetLocalBounds().Contains(point)) {
+    return nullptr;
+  }
+  for (auto i = children().rbegin(); i != children().rend(); ++i) {
+    auto* item = AsViewClass<MenuItemView>(*i);
+    if (!item || IsViewClass<EmptyMenuMenuItem>(item) || !item->GetVisible()) {
+      continue;
+    }
+    const gfx::Rect bounds = item->GetMirroredBounds();
+    if (point.x() >= bounds.x() && point.x() < bounds.right()) {
+      return item->GetEnabled() && point.y() >= bounds.bottom() ? item
+                                                                : nullptr;
+    }
+  }
+  return nullptr;
+}
