+std::optional<gfx::Size> MenuController::CalculateMultiColumnMenuSize(
+    MenuItemView* item,
+    const gfx::Rect& anchor_bounds,
+    bool bubble_menu) {
+  SubmenuView* submenu = item->GetSubmenu();
+  if (!submenu->use_multiple_columns()) {
+    return std::nullopt;
+  }
+  // A stationary drag must be hit-tested again after the columns move.
+  valid_drop_coordinates_ = false;
+  auto* container = submenu->GetScrollViewContainer();
+  const gfx::Rect& work_area = state_.monitor_bounds;
+  // Keep specialized pinned/combobox/system menus on their existing path.
+  if (work_area.IsEmpty() || ShouldIgnoreScreenBoundsForMenus() ||
+      IsCombobox() || use_ash_system_ui_layout_ || submenu->use_scroll_bar() ||
+      !container->pinned_header_region().empty() ||
+      !container->pinned_footer_region().empty()) {
+    submenu->SetMultiColumnLayoutBounds(gfx::Size(), 400);
+    return std::nullopt;
+  }
+
+  const gfx::Insets insets = container->GetInsets();
+  // Shadows may extend outside the work area; the visible menu may not.
+  const gfx::Insets outside =
+      bubble_menu ? container->outside_border_insets() : gfx::Insets();
+  const int max_column_width =
+      std::clamp(item->GetDelegate()->GetMaxWidthForMenu(item), 1, 400);
+  const int overlap = MenuConfig::instance().submenu_horizontal_overlap;
+  const int left_space = std::clamp(anchor_bounds.x() - work_area.x() + overlap,
+                                    0, work_area.width()) +
+                         outside.width();
+  const int right_space =
+      std::clamp(work_area.right() - anchor_bounds.right() + overlap, 0,
+                 work_area.width()) +
+      outside.width();
+  int max_width = work_area.width() + outside.width();
+  int max_height = work_area.height() + outside.height();
+  bool allow_multiple_columns = true;
+  const int anchor_offset = MenuItemView::IsBubble(state_.anchor)
+                                ? MenuConfig::instance().touchable_anchor_offset
+                                : 0;
+  const int above =
+      std::clamp(anchor_bounds.y() - work_area.y() - anchor_offset, 0,
+                 work_area.height()) +
+      outside.height();
+  const int below =
+      std::clamp(work_area.bottom() - anchor_bounds.bottom() - anchor_offset, 0,
+                 work_area.height()) +
+      outside.height();
+  if (item->GetParentMenuItem()) {
+    // Fit beside the originating column, so the submenu is directly reachable.
+    // On very narrow displays, overlap is unavoidable; keep a usable single
+    // column and clamp to screen.
+    const int side_width = std::max(left_space, right_space);
+    if (side_width >= std::min(max_column_width, 160) + insets.width()) {
+      max_width = side_width;
+    } else {
+      max_width = std::min(max_width, max_column_width + insets.width());
+      allow_multiple_columns = false;
+    }
+  } else {
+    using MenuPosition = MenuItemView::MenuPosition;
+    if (item->actual_menu_position() == MenuPosition::kAboveBounds) {
+      max_height = above;
+    } else if (item->actual_menu_position() == MenuPosition::kBelowBounds) {
+      max_height = below;
+    } else {
+      max_height = std::max(above, below);
+    }
+    if (max_height <= insets.height() + submenu->GetPreferredItemHeight()) {
+      max_height = work_area.height() + outside.height();
+    }
+  }
+
+  submenu->SetMultiColumnLayoutBounds(
+      gfx::Size(std::max(1, max_width - insets.width()),
+                std::max(1, max_height - insets.height())),
+      max_column_width, allow_multiple_columns);
+  gfx::Size size = container->GetPreferredSize({});
+  size.SetToMin(gfx::Size(max_width, max_height));
+
+  return size;
+}
