+void MenuScrollViewContainer::RefreshScrollButtons(bool use_layout_bounds) {
+  if (use_layout_bounds) {
+    // The host can be narrower than the measuring constraint, so columns may
+    // be taller after layout. Use actual bounds for both arrows and the scroll
+    // limit. Compare against the space without arrows to avoid keeping them
+    // visible solely because they themselves reduce the viewport height.
+    const bool overflows = content_view_->height() >
+                           background_view_->GetContentsBounds().height();
+    if (!overflows) {
+      content_view_->SetY(0);
+    }
+    scroll_up_button_->SetVisible(overflows && content_view_->y() < 0);
+    scroll_down_button_->SetVisible(
+        overflows && content_view_->bounds().bottom() > scroll_view_->height());
+  } else {
+    // Seed the arrows before the viewport is laid out. Column menus reconcile
+    // them with the actual height and preserved scroll offset after layout.
+    scroll_up_button_->SetVisible(false);
+    scroll_down_button_->SetVisible(
+        !scroll_bar_ && content_view_->GetPreferredSize({}).height() >
+                            GetContentsBounds().height());
+  }
 
