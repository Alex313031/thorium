diff --git a/BUILD.gn b/BUILD.gn
index d136cdfb312..03b62eaec53 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -381,7 +381,15 @@ declare_args() {
   # ARM64. Enable it by default for simulator builds and when native code
   # supports it as well. On Mac, control-flow integrity does not work so we
   # avoid enabling it when using the simulator.
+  #
+  # A Linux x64 mksnapshot targeting Windows or macOS ARM64 must match the
+  # target runtime, where arm_control_flow_integrity defaults to "none".
+  # The Linux simulator toolchain can enable PAC independently of the target,
+  # producing snapshot/embedded code with incompatible return addresses.
   v8_control_flow_integrity = v8_current_cpu == "arm64" &&
+                              !(host_os == "linux" && host_cpu == "x64" &&
+                                (target_os == "win" || target_os == "mac") &&
+                                target_cpu == "arm64") &&
                               ((v8_target_is_simulator && target_os != "mac") ||
                                arm_control_flow_integrity != "none")
 
diff --git a/gni/snapshot_toolchain.gni b/gni/snapshot_toolchain.gni
index 37ed262640d..5f3352a683f 100644
--- a/gni/snapshot_toolchain.gni
+++ b/gni/snapshot_toolchain.gni
@@ -46,7 +46,21 @@ declare_args() {
 # https://crbug.com/625353.
 
 if (v8_snapshot_toolchain == "") {
-  if (current_os == host_os && current_cpu == host_cpu) {
+  if (host_os == "linux" && host_cpu == "x64" &&
+      (current_os == "win" || current_os == "mac") &&
+      v8_current_cpu == "arm64") {
+    # Generate Windows and macOS ARM64 snapshots with the ARM64 simulator.
+    # Both targets need target-configured code from a Linux-hosted generator.
+    v8_snapshot_toolchain = "//build/toolchain/linux:clang_x64_v8_arm64"
+  } else if (host_os == "linux" && current_os == "linux" &&
+             host_cpu == "x64" && current_cpu == "x64" &&
+             host_toolchain ==
+                 "//build/toolchain/linux:clang_x64_thorium_build_host") {
+    # mksnapshot and the other V8 generators execute on the build host. Use
+    # Thorium's baseline host toolchain so an AVX-512 target can be built on
+    # an x64 host that does not itself implement AVX-512.
+    v8_snapshot_toolchain = host_toolchain
+  } else if (current_os == host_os && current_cpu == host_cpu) {
     # This is not a cross-compile, so build the snapshot with the current
     # toolchain.
     v8_snapshot_toolchain = current_toolchain
