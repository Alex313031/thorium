+bool UnloadController::CanCloseWithMultipleTabs() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("close-confirmation")) {
+    return true;
+  }
+
+  if (close_multitab_confirmation_state_ !=
+      CancelDownloadConfirmationState::kNotPrompted) {
+    return close_multitab_confirmation_state_ !=
+           CancelDownloadConfirmationState::kWaitingForResponse;
+  }
+
+  if (!g_browser_process->profile_manager()) {
+    return true;
+  }
+
+  const int tab_count = browser_->tab_strip_model()->count();
+  if (tab_count == 0) {
+    return true;
+  }
+
+  int total_window_count = 0;
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [&total_window_count, this](BrowserWindowInterface* browser) {
+        if (browser != browser_ &&
+            !browser->capabilities()->IsAttemptingToCloseBrowser()) {
+          ++total_window_count;
+        }
+        return true;
+      });
+
+  const std::string flag_value =
+      command_line->GetSwitchValueASCII("close-confirmation");
+  if (flag_value == "last") {
+    if (total_window_count >= 1 || tab_count <= 1) {
+      return true;
+    }
+  } else if (flag_value == "multiple") {
+    if (total_window_count == 0) {
+      return true;
+    }
+  } else if (flag_value != "any") {
+    return true;
+  }
+
+  close_multitab_confirmation_state_ =
+      CancelDownloadConfirmationState::kWaitingForResponse;
+
+  MessageBoxDialog::Show(
+      BrowserWindow::FromBrowser(browser_)->GetNativeWindow(),
+      l10n_util::GetStringUTF16(IDS_CONFIRM_CLOSE_WINDOW), std::u16string(),
+      chrome::MESSAGE_BOX_TYPE_QUESTION,
+      l10n_util::GetStringUTF16(IDS_APP_CLOSE),
+      l10n_util::GetStringUTF16(IDS_APP_CANCEL), std::u16string(),
+      base::BindOnce(&UnloadController::MultitabResponse,
+                     weak_factory_.GetWeakPtr()));
+
+  return false;
+}
