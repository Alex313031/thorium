+        GetGlyphIndicesW(dc, &ch, 1, &glyph, GGI_MARK_NONEXISTING_GLYPHS) == GDI_ERROR ||
+        glyph == 0xFFFF) {
+        *height = estimate;
+        return true;
+    }
+    int top;
+    const bool longLoca = be16(head, 50) == 1;
+    const DWORD entrySize = longLoca ? 4 : 2;
+    uint8_t loca[8];
+    if (GetFontData(
+                dc, font_table_tag('l', 'o', 'c', 'a'), glyph * entrySize, loca, 2 * entrySize) ==
+        2 * entrySize) {
+        const DWORD start = longLoca ? be32(loca, 0) : be16(loca, 0) * 2u;
+        const DWORD end = longLoca ? be32(loca, 4) : be16(loca, 2) * 2u;
+        if (start == end) {  // No outline, e.g. the letters of icon fonts.
+            *height = estimate;
+            return true;
+        }
+        uint8_t glyf[10];
+        if (end < start + sizeof(glyf) ||
+            GetFontData(dc, font_table_tag('g', 'l', 'y', 'f'), start, glyf, sizeof(glyf)) !=
+                    sizeof(glyf)) {
+            return false;
+        }
+        top = int16_t(be16(glyf, 8));
+    } else {
