+// Whether the font has an embedded bitmap strike for a size in [minPPEM,
+// maxPPEM], judged as Skia's DirectWrite port does (EBLC, else EBSC).
+static bool has_bitmap_strike(HDC dc, int minPPEM, int maxPPEM) {
+    // Reads a version 2.0 table's records (after its 8-byte header) into
+    // `records`; not the bitmap data that may follow them.
+    auto read_records = [dc](DWORD tag, uint32_t recordSize, std::vector<uint8_t>* records) {
+        uint8_t header[8];
+        const DWORD tableSize = GetFontData(dc, tag, 0, nullptr, 0);
+        if (tableSize == GDI_ERROR || tableSize < sizeof(header) ||
+            GetFontData(dc, tag, 0, header, sizeof(header)) != sizeof(header) ||
+            be32(header, 0) != 0x00020000) {
+            return false;
+        }
+        const uint32_t numSizes = be32(header, 4);
+        if (numSizes > 1024 || tableSize < sizeof(header) + recordSize * numSizes) {
+            return false;
+        }
+        const DWORD recordsSize = recordSize * numSizes;
+        records->resize(recordsSize);
+        return recordsSize == 0 ||
+               GetFontData(dc, tag, sizeof(header), records->data(), recordsSize) == recordsSize;
+    };
+    std::vector<uint8_t> records;
+    if (!read_records(font_table_tag('E', 'B', 'L', 'C'), 48, &records)) {
+        return false;
+    }
+    for (size_t offset = 0; offset < records.size(); offset += 48) {
+        const uint8_t* strike = records.data() + offset;  // BitmapSize
+        if (strike[44] == strike[45] && minPPEM <= strike[44] && strike[44] <= maxPPEM &&
+            be16(strike, 42) >= be16(strike, 40) + 3) {
+            return true;
+        }
+    }
+    if (!read_records(font_table_tag('E', 'B', 'S', 'C'), 28, &records)) {
+        return false;
+    }
+    for (size_t offset = 0; offset < records.size(); offset += 28) {
+        const uint8_t* scale = records.data() + offset;  // BitmapScale
+        if (scale[24] == scale[25] && minPPEM <= scale[24] && scale[24] <= maxPPEM) {
+            return true;
+        }
+    }
+    return false;
