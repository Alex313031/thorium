+#ifndef SK_GDI_ALWAYS_USE_TEXTMETRICS_FOR_FONT_METRICS
+static uint16_t be16(const uint8_t* data, size_t offset) {
+    return uint16_t((uint16_t(data[offset]) << 8) | data[offset + 1]);
+}
+
+static uint32_t be32(const uint8_t* data, size_t offset) {
+    return (uint32_t(be16(data, offset)) << 16) | be16(data, offset + 2);
+}
