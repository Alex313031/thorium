+        // units. GDI reports a 1x1 box for an empty glyph.
+        TEXTMETRIC tm;
+        if (!GetTextMetrics(dc, &tm) || tm.tmHeight - tm.tmInternalLeading <= 0) {
+            return false;
+        }
+        const FIXED toUnits =
+                SkFloatToFIXED(float(be16(head, 18)) / (tm.tmHeight - tm.tmInternalLeading));
+        const MAT2 mat = {toUnits, {0, 0}, {0, 0}, toUnits};
+        GLYPHMETRICS gm;
+        if (GetGlyphOutlineW(dc,
+                             glyph,
+                             GGO_METRICS | GGO_UNHINTED | GGO_GLYPH_INDEX,
+                             &gm,
+                             0,
+                             nullptr,
+                             &mat) == GDI_ERROR) {
+            return false;
+        }
