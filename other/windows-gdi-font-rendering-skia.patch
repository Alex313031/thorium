+// Reads up to `size` bytes from the start of the selected font's table `tag`.
+// Returns how many bytes were read: 0 if the table is missing.
+static DWORD read_font_table(HDC dc, DWORD tag, uint8_t* data, DWORD size) {
+    const DWORD tableSize = GetFontData(dc, tag, 0, nullptr, 0);
+    if (tableSize == GDI_ERROR || tableSize == 0) {
+        return 0;
+    }
+    size = std::min(size, tableSize);
+    return GetFontData(dc, tag, 0, data, size) == size ? size : 0;
+}
+
+// The gasp range holding `ppem`, read the way Skia's DirectWrite port reads it.
+struct GaspRange {
+    int fVersion;
+    int fMin;
+    int fMax;
+    uint16_t fFlags;
+};
+static bool get_gasp_range(HDC dc, int ppem, GaspRange* range) {
+    const DWORD tag = font_table_tag('g', 'a', 's', 'p');
+    const DWORD tableSize = GetFontData(dc, tag, 0, nullptr, 0);
+    if (tableSize == GDI_ERROR || tableSize < 4) {
+        return false;
+    }
+    std::vector<uint8_t> gasp(tableSize);
+    if (GetFontData(dc, tag, 0, gasp.data(), tableSize) != tableSize) {
+        return false;
+    }
+    const int version = be16(gasp.data(), 0);
+    const int numRanges = be16(gasp.data(), 2);
+    if (version > 1 || numRanges > 1024 || tableSize < 4 + 4u * numRanges) {
+        return false;
+    }
+    int minPPEM = -1;
+    for (int i = 0; i < numRanges; ++i) {
+        const int maxPPEM = be16(gasp.data(), 4 + 4 * i);
+        if (minPPEM < ppem && ppem <= maxPPEM) {
+            *range = {version, minPPEM + 1, maxPPEM, be16(gasp.data(), 6 + 4 * i)};
+            return true;
+        }
+        minPPEM = maxPPEM;
+    }
+    return false;
+}
