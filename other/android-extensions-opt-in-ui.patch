+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import {html} from '//resources/lit/v3_0/lit.rollup.js';
+
+import type {ExtensionsAppElement} from './app.js';
+
+export function getHtml(this: ExtensionsAppElement) {
+  // clang-format off
+  return html`<!--_html_template_start_-->
+${this.androidExtensionsDisabled_ ? html`
+  <div id="disabled-container">
+    <main id="android-extensions-disabled" aria-labelledby="disabled-title">
+      <h1 id="disabled-title">$i18n{androidExtensionsDisabledTitle}</h1>
+      <p id="disabled-description">$i18n{androidExtensionsDisabledDescription}</p>
+      <p>
+        <a id="enable-extensions-link"
+            href="chrome://flags/#enable-extensions-android">
+          chrome://flags/#enable-extensions-android
+        </a>
+      </p>
+      <cr-button id="loadUnpacked" disabled
+          aria-describedby="disabled-description">
+        $i18n{toolbarLoadUnpacked}
+      </cr-button>
+    </main>
+  </div>
+` : html`
+  <extensions-manager></extensions-manager>
+`}
+<!--_html_template_end_-->`;
+  // clang-format on
+}
diff --git a/chrome/browser/resources/extensions/app.ts b/chrome/browser/resources/extensions/app.ts
new file mode 100644
index 0000000000000..390a71c48e21a
--- /dev/null
+++ b/chrome/browser/resources/extensions/app.ts
@@ -0,0 +1,69 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import './manager.js';
+
+import {ColorChangeUpdater, COLORS_CSS_SELECTOR} from 'chrome://resources/cr_components/color_change_listener/colors_css_updater.js';
+import {loadTimeData} from 'chrome://resources/js/load_time_data.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss} from './app.css.js';
+import {getHtml} from './app.html.js';
+
+export class ExtensionsAppElement extends CrLitElement {
+  static get is() {
+    return 'extensions-app';
+  }
+
+  static override get styles() {
+    return getCss();
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      androidExtensionsDisabled_: {type: Boolean, attribute: false},
+    };
+  }
+
+  // The feature state is fixed for this page load and requires a relaunch to
+  // change. Do not expose it as a mutable DOM attribute.
+  protected accessor androidExtensionsDisabled_: boolean =
+      loadTimeData.getBoolean('androidExtensionsDisabled');
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    // The manager owns normal-page initialization. It is never instantiated
+    // while Android extension support is disabled.
+    if (!this.androidExtensionsDisabled_) {
+      return;
+    }
+
+    if (loadTimeData.getString('webuiRefresh2026') !== '') {
+      if (!document.body.querySelector(COLORS_CSS_SELECTOR)) {
+        const link = document.createElement('link');
+        link.rel = 'stylesheet';
+        link.href = 'chrome://theme/colors.css?sets=ui,chrome';
+        document.body.appendChild(link);
+      }
+      ColorChangeUpdater.forDocument().start();
+    }
+
+    document.documentElement.classList.remove('loading');
+    document.fonts.load('bold 12px Roboto');
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'extensions-app': ExtensionsAppElement;
+  }
+}
+
+customElements.define(ExtensionsAppElement.is, ExtensionsAppElement);
